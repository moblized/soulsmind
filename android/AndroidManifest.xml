<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.moblized.soulsmind">
    <!-- versionCode and versionName are inserted by android/build.sh (VERSION_CODE / VERSION_NAME). -->

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- The game itself is offline; the network is used only to look for and download updates. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Short rumbles when you take a hit, fall, or fell a boss. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets the app install its own updates from GitHub releases; Android asks the player to confirm each one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:label="Souls Mind"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Rimebell"
        android:isGame="true"
        android:allowBackup="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Rimebell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
